---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SidebarTree from '../../components/SidebarTree.astro';
import GameCard from '../../components/GameCard.astro';
import CatalogFilters from '../../components/CatalogFilters.astro';
import { getGraph, studioShort } from '../../lib/graph';
import { catalogUrl, studioUrl } from '../../lib/paths';
import { TYPE_LABEL, nGames, plural } from '../../lib/labels';

export const getStaticPaths: GetStaticPaths = async () => {
  const graph = await getGraph();
  const types = new Set(graph.gameList.map((g) => g.data.type));
  return [...types].map((type) => ({ params: { type }, props: { type } }));
};

const { type } = Astro.props as { type: string };
const graph = await getGraph();

const games = graph.gameList.filter((g) => g.data.type === type);
const studios = graph.studioList
  .map((s) => ({
    studio: s,
    items: games.filter((g) => g.studioId === s.id),
  }))
  .filter((gr) => gr.items.length > 0);
---

<Base title={TYPE_LABEL[type] ?? type} description={`${TYPE_LABEL[type] ?? type}: каталог по студиям и сериям.`} sidebar>
  <SidebarTree slot="sidebar" graph={graph} type={type} />

  <nav class="crumbs-mini">
    <a href={catalogUrl()}>Каталог</a> › <span>{TYPE_LABEL[type] ?? type}</span>
  </nav>

  <div class="section-title">
    <h1>{TYPE_LABEL[type] ?? type}</h1>
    <span class="muted" data-progress data-progress-scope="#catalog-list"></span>
  </div>

  <p class="muted">
    {nGames(games.length)} от {studios.length} {plural(studios.length, 'студии', 'студий', 'студий')}
  </p>

  <button class="tree-open" type="button" data-tree-open>Дерево каталога</button>

  <CatalogFilters graph={graph} games={games} />

  <div id="catalog-list">
    {
      studios.map((group) => (
        <section class="studio-group" data-studio-group={group.studio.id}>
          <div class="section-title">
            <h2>
              <a href={studioUrl(group.studio.id)}>{studioShort(group.studio)}</a>
            </h2>
            <span class="muted">{group.studio.data.city}</span>
          </div>
          <ul class="grid-cards">
            {group.items.map((g) => (
              <GameCard game={g} graph={graph} />
            ))}
          </ul>
        </section>
      ))
    }
    <p class="empty" data-empty hidden>Под выбранные условия ничего не подошло.</p>
  </div>
</Base>

<dialog class="tree-drawer" data-tree-drawer aria-label="Дерево каталога">
  <div class="tree-drawer__inner">
    <SidebarTree graph={graph} type={type} />
    <button class="tree-drawer__close" type="button" data-tree-close>Закрыть</button>
  </div>
</dialog>

<style>
  .crumbs-mini {
    margin: 0.75rem 0 0.25rem;
    font-size: 0.88rem;
    color: var(--c-muted);
  }

  .studio-group {
    margin-bottom: 2rem;
  }

  .studio-group h2 {
    margin-bottom: 0.5rem;
  }

  .studio-group h2 a {
    color: inherit;
    text-decoration: none;
  }

  .studio-group h2 a:hover {
    text-decoration: underline;
  }

  .empty {
    padding: 1.5rem;
    text-align: center;
    color: var(--c-muted);
    border: 1px dashed var(--c-border);
    border-radius: var(--radius);
  }

  .tree-open {
    display: block;
    width: 100%;
    margin: 0.5rem 0 1rem;
    padding: 0.6rem;
    font: inherit;
    background: var(--c-surface);
    border: var(--rule);
    border-radius: var(--radius-sm);
    color: var(--c-text);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .tree-open {
      display: none;
    }
  }

  .tree-drawer {
    border: 0;
    padding: 0;
    margin: 0 auto auto 0;
    height: 100dvh;
    max-height: 100dvh;
    width: min(20rem, 85vw);
    background: var(--c-surface);
  }

  .tree-drawer::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }

  .tree-drawer__inner {
    padding: 1rem;
    height: 100%;
    overflow-y: auto;
  }

  .tree-drawer__close {
    width: 100%;
    margin-top: 1rem;
    padding: 0.7rem;
    font: inherit;
    background: var(--c-accent);
    color: var(--c-on-accent);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
</style>
