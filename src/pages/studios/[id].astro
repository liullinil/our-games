---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import { getGraph, studioShort } from '../../lib/graph';
import { seriesUrl, engineUrl, studioUrl, withBase } from '../../lib/paths';
import { COUNTRY_LABEL, STUDIO_KIND_LABEL, STUDIO_RELATION_LABEL, nGames } from '../../lib/labels';

export const getStaticPaths: GetStaticPaths = async () => {
  const graph = await getGraph();
  return graph.studioList.map((s) => ({ params: { id: s.id }, props: { studioId: s.id } }));
};

const { studioId } = Astro.props as { studioId: string };
const graph = await getGraph();
const studio = graph.studios.get(studioId)!;
const { Content } = await render(studio.entry);

const games = studio.gameIds.map((id) => graph.games.get(id)!);
const published = studio.publishedIds
  .filter((id) => !studio.gameIds.includes(id))
  .map((id) => graph.games.get(id)!);
const names = [...studio.data.names].sort((a, b) => a.from - b.from);
const engines = studio.engineIds.map((id) => graph.engines.get(id)!).filter(Boolean);

/*
 * Родня студии.
 *
 * Студии здесь делятся, переименовываются и разбегаются постоянно: после
 * закрытия GSC её команда собралась в 4A Games и Vostok Games, из «Нивала»
 * вышли Owlcat и Skyfallen. Связь записана в карточке одной из студий, а
 * показывается у обеих — подпись зависит от того, с какой стороны смотреть.
 */
const kin = studio.kin
  .map((k) => {
    const other = graph.studios.get(k.studioId);
    if (!other) return null;
    const label = STUDIO_RELATION_LABEL[k.kind];
    return {
      id: other.id,
      name: studioShort(other),
      label: k.side === 'own' ? label.own : label.mirror,
      note: k.note,
      games: other.gameIds.length,
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

// Оформление страницы студии — по эпохе её первой игры: так «Никита» читается
// в девяностых, а Mundfish — в двадцатых.
const era = games[0]?.era ?? 'site';
---

<Base title={studioShort(studio)} description={studio.data.summary} era={era}>
  <nav class="crumbs-mini">
    <a href={withBase('/studios/')}>Студии</a> › <span>{studioShort(studio)}</span>
  </nav>

  <article data-pagefind-body>
    <header class="studio-head">
      {studio.data.logo && <Image class="studio-logo" src={studio.data.logo} alt="" width={96} height={96} />}
      <div>
        <h1 data-pagefind-meta="title">{studioShort(studio)}</h1>
        <p class="lead">{studio.data.summary}</p>
        <p class="muted">
          {[
            studio.data.city,
            studio.data.country && COUNTRY_LABEL[studio.data.country],
            STUDIO_KIND_LABEL[studio.data.kind],
          ]
            .filter(Boolean)
            .join(' · ')}{studio.data.founded ? ` · основана в ${studio.data.founded}` : ''}
          {studio.data.closed ? `, закрыта в ${studio.data.closed}` : ''}
          {studio.data.website && (
            <>
              {' · '}
              <a href={studio.data.website} rel="noopener external">
                сайт
              </a>
            </>
          )}
        </p>
      </div>
    </header>

    {
      names.length > 1 && (
        <>
          <h2>Названия по годам</h2>
          <ol class="names">
            {names.map((n) => (
              <li>
                <span class="names__years">
                  {n.from}
                  {n.to ? `–${n.to}` : ' — н. в.'}
                </span>
                <span class="names__full">{n.name}</span>
                <span class="muted">{n.short}</span>
              </li>
            ))}
          </ol>
        </>
      )
    }

    {
      kin.length > 0 && (
        <>
          <h2>Родственные студии</h2>
          <ul class="kin">
            {kin.map((k) => (
              <li class="kin__item">
                <span class="kin__label muted">{k.label}</span>
                <a class="kin__name" href={studioUrl(k.id)}>
                  {k.name}
                </a>
                {k.games > 0 && <span class="muted">{nGames(k.games)}</span>}
                {k.note && <span class="kin__note muted">{k.note}</span>}
              </li>
            ))}
          </ul>
        </>
      )
    }

    <Content />
  </article>

  {
    (studio.seriesIds.length > 0 || engines.length > 0) && (
      <section data-pagefind-ignore class="chips-section">
        {studio.seriesIds.length > 0 && (
          <>
            <h2>Серии</h2>
            <ul class="chips">
              {studio.seriesIds.map((sid) => {
                const s = graph.series.get(sid)!;
                return (
                  <li>
                    <a class="chip" href={seriesUrl(sid)}>
                      {s.data.name}
                      <span class="muted">{s.gameIds.length}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </>
        )}
        {engines.length > 0 && (
          <>
            <h2>Движки студии</h2>
            <ul class="chips">
              {engines.map((e) => (
                <li>
                  <a class="chip" href={engineUrl(e.id)}>
                    {e.data.name}
                    <span class="muted">{e.gameIds.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {
    games.length > 0 && (
      <section data-pagefind-ignore>
        <div class="section-title">
          <h2>Игры студии</h2>
          <span class="muted" data-progress data-progress-scope="#studio-games"></span>
        </div>
        <p class="muted">{nGames(games.length)}</p>
        <ul class="grid-cards" id="studio-games">
          {games.map((g) => (
            <GameCard game={g} graph={graph} />
          ))}
        </ul>
      </section>
    )
  }

  {
    published.length > 0 && (
      <section data-pagefind-ignore>
        <div class="section-title">
          <h2>Изданные игры других студий</h2>
          <span class="muted" data-progress data-progress-scope="#studio-published"></span>
        </div>
        <ul class="grid-cards" id="studio-published">
          {published.map((g) => (
            <GameCard game={g} graph={graph} />
          ))}
        </ul>
      </section>
    )
  }

  {
    studio.data.sources.length > 0 && (
      <section data-pagefind-ignore>
        <h2>Источники</h2>
        <ol class="sources">
          {studio.data.sources.map((s) => (
            <li>
              {s.url ? (
                <a href={s.url} rel="noopener external">
                  {s.title}
                </a>
              ) : (
                s.title
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .crumbs-mini {
    margin: 0.75rem 0 0.25rem;
    font-size: 0.88rem;
    color: var(--c-muted);
  }

  .studio-head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .studio-logo {
    flex: none;
    width: 6rem;
    height: 6rem;
    object-fit: contain;
    margin-top: 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--c-surface);
    padding: 0.4rem;
    border: var(--rule);
  }

  .lead {
    max-width: 40rem;
    font-size: 1.05rem;
  }

  .names {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.35rem;
  }

  .names li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.35rem 0;
    border-bottom: var(--rule);
    font-size: 0.92rem;
  }

  .names__years {
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .kin {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    margin: 0.6rem 0 1.5rem;
    list-style: none;
  }

  .kin__item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--c-border);
    font-size: 0.92rem;
  }

  .kin__item:hover {
    border-left-color: var(--c-accent);
  }

  .kin__name {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
  }

  /* Пояснение идёт своей строкой: оно длиннее самой связи. */
  .kin__note {
    flex-basis: 100%;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  @media (max-width: 520px) {
    .names li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .studio-head {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .sources {
    padding-left: 1.2rem;
    font-size: 0.92rem;
  }
</style>
