---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import { getGraph, studioShort } from '../../lib/graph';
import { eraUrl, withBase, studioUrl, platformUrl } from '../../lib/paths';
import { nGames } from '../../lib/labels';

export const getStaticPaths: GetStaticPaths = async () => {
  const graph = await getGraph();
  return graph.eraList.map((e) => ({ params: { id: e.id }, props: { eraId: e.id } }));
};

const { eraId } = Astro.props as { eraId: string };
const graph = await getGraph();
const era = graph.eras.get(eraId)!;
const games = graph.gameList.filter((g) => g.era === eraId);

const index = graph.eraList.findIndex((e) => e.id === eraId);
const prev = graph.eraList[index - 1];
const next = graph.eraList[index + 1];

// Студии, чья первая игра вышла в эту эпоху, и платформы, появившиеся в ней.
const studios = graph.studioList.filter((s) => {
  const first = s.gameIds[0];
  return first && graph.games.get(first)!.era === eraId;
});
const platforms = graph.platformList.filter((p) => {
  const start = p.data.years.start;
  return start >= era.data.from && (era.data.to === null || start < era.data.to);
});
const articles = games.filter((g) => g.data.status === 'article').length;
---

<Base title={era.data.title} description={era.data.description} era={eraId} mainClass="era">
  <nav class="crumbs-mini">
    <a href={withBase('/eras/')}>Эпохи</a> › <span>{era.data.title}</span>
  </nav>

  <article data-pagefind-body>
    <header class="era__head">
      <p class="era__range">{era.data.range}</p>
      <h1 data-pagefind-meta="title">{era.data.title}</h1>
      <p class="lead">{era.data.description}</p>
    </header>

    {
      era.data.images.length > 0 && (
        <section class="era__mosaic" aria-label="Образы эпохи" data-pagefind-ignore>
          {era.data.images.map((img, i) => (
            <figure class:list={['era__shot', { 'era__shot--wide': i === 0 }]}>
              <Image
                src={img.src}
                alt={img.caption}
                widths={[480, 960]}
                sizes={i === 0 ? '(max-width: 700px) 100vw, 640px' : '(max-width: 700px) 50vw, 320px'}
                loading={i < 2 ? 'eager' : 'lazy'}
              />
              <figcaption>
                <span>{img.caption}</span>
                <span class="era__credit">
                  {`Фото: ${img.author}, `}
                  {img.licenseUrl ? (
                    <a href={img.licenseUrl} rel="license noopener">
                      {img.license}
                    </a>
                  ) : (
                    img.license
                  )}
                  {', '}
                  <a href={img.sourceUrl} rel="noopener external">
                    Викисклад
                  </a>
                </span>
              </figcaption>
            </figure>
          ))}
        </section>
      )
    }

    <div class="era__grid">
      <section class="era__style card">
        <h2>Оформление</h2>
        <p>{era.data.styleNote}</p>
      </section>
      {
        era.data.motifs.length > 0 && (
          <section class="era__motifs card">
            <h2>Приметы времени</h2>
            <ul>
              {era.data.motifs.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  {
    (studios.length > 0 || platforms.length > 0) && (
      <section class="era__around" data-pagefind-ignore>
        {studios.length > 0 && (
          <div>
            <h2>Студии, начавшие в эту эпоху</h2>
            <ul class="chips">
              {studios.map((s) => (
                <li>
                  <a class="chip" href={studioUrl(s.id)}>
                    {studioShort(s)}
                    <span class="muted">{s.gameIds.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {platforms.length > 0 && (
          <div>
            <h2>Платформы эпохи</h2>
            <ul class="chips">
              {platforms.map((p) => (
                <li>
                  <a class="chip" href={platformUrl(p.id)}>
                    {p.data.name}
                    <span class="muted">{p.data.years.start}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <section data-pagefind-ignore>
    <div class="section-title">
      <h2>Игры эпохи</h2>
      <span class="muted" data-progress data-progress-scope="#era-games"></span>
    </div>
    <p class="muted">
      {nGames(games.length)}{articles > 0 ? `, подробно ${articles}` : ''}
    </p>
    <ul class="grid-cards" id="era-games">
      {games.map((g) => <GameCard game={g} graph={graph} />)}
    </ul>
  </section>

  <nav class="era-nav">
    {prev ? <a href={eraUrl(prev.id)}>← {prev.data.shortTitle}</a> : <span />}
    {next ? <a href={eraUrl(next.id)}>{next.data.shortTitle} →</a> : <span />}
  </nav>
</Base>

<style>
  .crumbs-mini {
    margin: 0.75rem 0 0.25rem;
    font-size: 0.88rem;
    color: var(--c-muted);
  }

  .era__range {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    color: var(--c-accent);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
  }

  .era__head h1 {
    margin-top: 0.1em;
  }

  .lead {
    max-width: 46rem;
    font-size: 1.08rem;
  }

  /* Мозаика образов эпохи: первый снимок крупно, остальные плиткой. */
  .era__mosaic {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .era__shot {
    margin: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .era__shot--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .era__shot :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: var(--rule);
    background: var(--c-surface-2);
    filter: var(--photo-filter);
  }

  .era__shot--wide :global(img) {
    aspect-ratio: 4 / 3;
    height: 100%;
  }

  .era__shot figcaption {
    display: grid;
    gap: 0.1rem;
  }

  .era__credit {
    color: var(--c-muted);
  }

  @media (max-width: 760px) {
    .era__mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .era__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }

  .era__style,
  .era__motifs {
    padding: 0.9rem 1.1rem 1.1rem;
  }

  .era__style h2,
  .era__motifs h2 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .era__style p {
    margin: 0;
    font-size: 0.95rem;
  }

  .era__motifs ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.95rem;
  }

  .era__around {
    display: grid;
    gap: 0.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }

  .era-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: var(--rule);
  }
</style>
