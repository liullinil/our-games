---
import { withBase } from '../lib/paths';
import QuickSwitch from './QuickSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (prefix: string) => path.startsWith(withBase(prefix));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href={withBase('/')}>
      {/* Знак сайта — геймпад, тот же, что и в иконке вкладки. */}
      <span class="site-header__mark" aria-hidden="true">
        <svg viewBox="2 7 28 20"><path fill-rule="evenodd" d="M11 9h10c2.5 0 4.3 1.6 4.8 3.9l1.9 8.4c.5 2.3-1 3.9-2.9 3.9-1 0-1.8-.4-2.5-1.2l-2.6-3H11.3l-2.6 3c-.7.8-1.5 1.2-2.5 1.2-1.9 0-3.4-1.6-2.9-3.9l1.9-8.4C5.7 10.6 7.5 9 10 9zM9.6 12.6h2.3v2.2h2.2v2.3h-2.2v2.2H9.6v-2.2H7.4v-2.3h2.2zM23.1 14.6a1.7 1.7 0 1 1-3.4 0 1.7 1.7 0 0 1 3.4 0zM26 18.1a1.7 1.7 0 1 1-3.4 0 1.7 1.7 0 0 1 3.4 0z" /></svg>
      </span>
      <span class="site-header__name">Наши <span class="site-header__hard">Игры</span></span>
    </a>

    <nav class="site-header__nav" aria-label="Основные разделы">
      <a href={withBase('/catalog/')} aria-current={isActive('/catalog') ? 'page' : undefined}>Каталог</a>
      <a
        class="site-header__main"
        href={withBase('/graph/')}
        aria-current={isActive('/graph') ? 'page' : undefined}>Карта связей</a
      >
      <a href={withBase('/studios/')} aria-current={isActive('/studios') ? 'page' : undefined}>Студии</a>
      <a href={withBase('/platforms/')} aria-current={isActive('/platforms') ? 'page' : undefined}>Платформы</a>
      <a href={withBase('/eras/')} aria-current={isActive('/eras') ? 'page' : undefined}>Эпохи</a>
    </nav>

    <QuickSwitch />
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--c-surface);
    border-bottom: var(--rule);
    background-image: var(--header-texture);
  }

  .site-header__inner {
    width: min(100% - 2rem, var(--content-width));
    margin-inline: auto;
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--c-text);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    text-transform: var(--case-display);
    letter-spacing: var(--tracking-display);
    flex: none;
  }

  .site-header__mark {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: var(--radius-sm);
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .site-header__mark svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .site-header__name {
    font-size: 1.05rem;
  }

  .site-header__hard {
    color: var(--c-accent);
  }

  .site-header__nav {
    display: none;
    gap: 1rem;
    margin-left: 0.5rem;
  }

  .site-header__nav a {
    color: var(--c-text);
    text-decoration: none;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    border-bottom-color: var(--c-accent);
  }

  .site-header__main {
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: flex;
    }
  }

  @media (max-width: 400px) {
    .site-header__name {
      display: none;
    }
  }
</style>
