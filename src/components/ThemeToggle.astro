---
/**
 * Два переключателя вида: светлая/тёмная и оформление по эпохе.
 *
 * Тема эпохи задаёт характер страницы, а светлая или тёмная — только яркость:
 * каждая эпоха хранит собственную тёмную палитру в --d-*, см. tokens.css.
 * Без выбора идём за системной настройкой.
 *
 * Оформление по эпохе можно выключить: тогда весь сайт читается современной
 * темой. Смена шрифтов и красок от эпохи к эпохе нравится не всем и не всегда
 * помогает читать длинную статью.
 */
---

<div class="viewswitch">

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Тёмная тема">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      fill="none"></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
  </svg>
</button>

<button
  class="theme-toggle era-toggle"
  type="button"
  data-era-toggle
  aria-pressed="true"
  aria-label="Оформление по эпохе"
  title="Оформление по эпохе"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 3a9 9 0 0 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-.8.7-1.5 1.5-1.5H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7zm-5.5 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3.5 3a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
    ></path>
  </svg>
</button>
</div>

<style>
  .viewswitch {
    display: inline-flex;
    gap: 0.3rem;
    flex: none;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    padding: 0;
    background: none;
    border: var(--rule);
    border-radius: 999px;
    color: var(--c-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
    grid-area: 1 / 1;
  }

  /* Показываем то, на что переключит нажатие. */
  .theme-toggle__sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle__sun {
    display: block;
  }

  :global(html[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .theme-toggle__sun {
      display: block;
    }

    :global(html:not([data-theme='light'])) .theme-toggle__moon {
      display: none;
    }
  }

  /* Выключенное оформление по эпохе видно по кнопке: она гаснет. */
  .era-toggle[aria-pressed='true'] {
    color: var(--c-accent);
    border-color: var(--c-accent);
  }

  .era-toggle[aria-pressed='false'] svg {
    opacity: 0.5;
  }
</style>

<script>
  import '../scripts/theme';
</script>
