---
/**
 * Карта связей — лента времени, разложенная плиткой.
 *
 * Прошлая карта отводила строку под студию: 106 студий по вертикали и 51 год
 * по горизонтали давали полотно в полторы сотни дорожек, и половина их
 * пустовала — у 54 студий ровно одна игра. Владелец забраковал саму эту
 * задумку: «длинная узкая полоса, которой неудобно пользоваться».
 *
 * Здесь наоборот. Колонка — год, карточки внутри колонки лежат плиткой
 * сверху вниз, и высота колонки зависит от того, сколько игр вышло в этот
 * год, а не от числа студий. Самый густой год — одиннадцать игр, так что
 * колонка никогда не выше одиннадцати карточек. Студия не занимает строку,
 * а стоит подписью на карточке.
 *
 * Лента свёрнута по эпохам: каждая эпоха — своя полоса, внутри неё только
 * её годы. Без этого сетка 37 на 11 вытянулась бы на шесть тысяч пикселей
 * вширь — та же полоса, только лежачая. С переносом по эпохам самая широкая
 * полоса (нулевые и десятые) укладывается в полторы тысячи, а карта растёт
 * вниз, как обычная страница.
 *
 * Линии не рисуются все разом: двести игр дают сотни рёбер и карта
 * превращается в паутину. Связи показываются при наведении на карточку —
 * выбранный вид родства ярко, остальные приглушённо.
 */
import type { Graph, GameNode } from '../lib/graph';
import { studioNameAt } from '../lib/graph';
import { withBase, desktopPaths, type SitePaths } from '../lib/paths';
import { CLASS_LABEL, TYPE_LABEL_ONE } from '../lib/labels';
import { REL_KINDS, REL_LABEL, neighbourMap, lonelyNodes } from '../lib/relations';
import { spriteLayout } from '../lib/graph-sprite';

interface Props {
  graph: Graph;
  games: GameNode[];
  /** Высота окна карты; на главной она ниже, чем на своей странице. */
  height?: string;
  /** Адреса страниц: настольные по умолчанию, мобильные — под /m/. */
  paths?: SitePaths;
}

const { graph, games, height, paths = desktopPaths } = Astro.props;
const { gameUrl } = paths;

/** Лист миниатюр: одна картинка на всю карту, см. lib/graph-sprite.ts. */
const sprite = spriteLayout(graph);
const spriteUrl = `${withBase('/graph-sprite.webp')}?v=${__BUILD_ID__}`;

/*
 * Дополнения и переиздания прячем внутрь карточки базовой игры.
 *
 * Отдельными плитками они только загущают колонку: «Ил-2 Штурмовик» с
 * четырьмя дополнениями занял бы половину года. На карточке базовой игры
 * стоит счётчик, а список раскрывается по наведению.
 */
const fold = new Map<string, string>();
for (const v of games) {
  if (v.data.kind !== 'game' && v.baseGameId && graph.games.has(v.baseGameId)) {
    fold.set(v.id, v.baseGameId);
  }
}
const shown = games.filter((v) => !fold.has(v.id));
const visible = new Set(shown.map((v) => v.id));

const modsOf = new Map<string, GameNode[]>();
for (const [modId, baseId] of fold) {
  const list = modsOf.get(baseId) ?? [];
  list.push(graph.games.get(modId)!);
  modsOf.set(baseId, list);
}
for (const list of modsOf.values()) {
  list.sort((a, b) => a.data.years.start - b.data.years.start);
}

/** Вторая строка карточки: кто сделал и в каком жанре. */
function metaOf(v: GameNode): string {
  const studio = graph.studios.get(v.studioId);
  const name = studio ? studioNameAt(studio, v.data.years.start) : '';
  const genre = v.data.type === 'other' ? CLASS_LABEL[v.data.class] : TYPE_LABEL_ONE[v.data.type];
  return name || genre || '';
}

/*
 * Раскладка: эпоха → год → карточки.
 *
 * Внутри года карточки идут по студии, а потом по названию. Порядок
 * произвольный, но устойчивый: от сборки к сборке одна и та же игра стоит на
 * одном месте, и человек, вернувшийся на карту, находит её там же.
 */
interface Column {
  year: number;
  games: GameNode[];
}
interface EraBand {
  id: string;
  title: string;
  range: string;
  columns: Column[];
  count: number;
}

const byEra = new Map<string, GameNode[]>();
for (const v of shown) {
  const list = byEra.get(v.era) ?? [];
  list.push(v);
  byEra.set(v.era, list);
}

const bands: EraBand[] = [];
for (const era of graph.eraList) {
  const list = byEra.get(era.id);
  if (!list || list.length === 0) continue;
  const byYear = new Map<number, GameNode[]>();
  for (const v of list) {
    const year = v.data.years.start;
    const col = byYear.get(year) ?? [];
    col.push(v);
    byYear.set(year, col);
  }
  const columns = [...byYear.entries()]
    .sort((a, b) => a[0] - b[0])
    .map(([year, items]) => ({
      year,
      games: items.sort((a, b) => metaOf(a).localeCompare(metaOf(b), 'ru') || a.data.name.localeCompare(b.data.name, 'ru')),
    }));
  bands.push({
    id: era.id,
    title: era.data.shortTitle ?? era.data.title,
    range: era.data.range,
    columns,
    count: list.length,
  });
}


const neighbours = neighbourMap(graph, visible, fold);
/*
 * Одиночка — это игра, к которой на карте не ведёт ни одна линия. Карточка
 * с раскрывающимся списком дополнений одиночкой не считается: связь у неё
 * видна, просто нарисована не линией, а счётчиком.
 */
const lonely = lonelyNodes(neighbours).filter((id) => !modsOf.has(id));
if (lonely.length > 0) {
  // Не роняем сборку: одиночки — это пробел в данных, а не поломка кода.
  console.warn(`Карта связей: без единой связи остались ${lonely.length} игр — ${lonely.join(', ')}`);
}

/** Соседи в разметке: скрипт рисует по ним линии при наведении. */
const neighbourJson = JSON.stringify(
  Object.fromEntries(
    Object.entries(neighbours).map(([id, kinds]) => [
      id,
      Object.fromEntries(Object.entries(kinds).filter(([, list]) => list.length > 0)),
    ]),
  ),
);

/** Знак для карточки без фотографии: первые буквы и цифры названия. */
const mark = (name: string) => name.replace(/[^\dA-Za-zА-Яа-я]/g, '').slice(0, 3);

const cellOf = (id: string) => sprite.cells.get(id);
---

<div
  class="rgraph"
  data-rgraph
  data-rel="predecessor"
  data-cards={withBase('/graph-cards.json')}
  data-game-base={paths.prefix ? paths.gameBase : undefined}
  data-neighbours={neighbourJson}
  style={height ? `--rgraph-height:${height}` : undefined}
>
  <div class="rgraph__toolbar">
    <div class="rgraph__kinds scroll-x" role="group" aria-label="Вид связей">
      {
        REL_KINDS.map((kind) => (
          <button
            class="chip"
            type="button"
            data-rel-kind={kind}
            aria-pressed={kind === 'predecessor' ? 'true' : 'false'}
          >
            {REL_LABEL[kind]}
          </button>
        ))
      }
    </div>
    <div class="rgraph__tools">
      {/* Фильтр один, и состояние у него видно сразу: нажатый — залит акцентом и с галочкой. */}
      <button
        class="chip rgraph__hide"
        type="button"
        data-hide-read
        aria-pressed="false"
        title="Убрать с карты игры, статьи о которых уже прочитаны"
      >
        Скрыть прочитанные<span class="rgraph__hidecount" data-hide-count></span>
      </button>
      <button class="chip" type="button" data-rfull aria-pressed="false">На весь экран</button>
    </div>
  </div>

  {/* Про наведение пишем только там, где оно есть: на телефоне работает нажатие. */}
  <p class="rgraph__hint">
    <span class="rgraph__hint--hover">Наведите на игру</span><span class="rgraph__hint--tap"
      >Нажмите на игру</span
    > — покажутся её связи. Вид родства выбирается кнопкой слева.
  </p>

  <div class="rgraph__frame" data-rgraph-frame>
    <div class="rgraph__scroll" data-rgraph-scroll>
      <div class="rgraph__content" data-rgraph-content>
        {/* Линии поверх плиток: координаты берутся из разметки уже в браузере. */}
        <svg class="rgraph__wires" data-rgraph-wires aria-hidden="true">
          <defs>
            <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
              <path d="M0 0 L8 4 L0 8 z" fill="currentColor"></path>
            </marker>
          </defs>
        </svg>

        {
          bands.map((band) => (
            <section class="rband" data-era={band.id}>
              <header class="rband__head">
                <h3>{band.title}</h3>
                <span class="rband__range">{band.range}</span>
                <span class="rband__count">{band.count}</span>
              </header>
              <div class="rband__years">
                {band.columns.map((col) => (
                  <div class="rcol">
                    <div class="rcol__year">{col.year}</div>
                    <div class="rcol__stack">
                      {col.games.map((v) => {
                        const cell = cellOf(v.id);
                        const mods = modsOf.get(v.id);
                        return (
                          <a
                            class="rcard"
                            href={gameUrl(v.id)}
                            data-node={v.id}
                            data-era={v.era}
                            data-mods={mods ? mods.length : undefined}
                            title={mods ? `${v.data.name} — и ещё ${mods.length} в этой карточке` : v.data.name}
                          >
                            <span
                              class="rcard__thumb"
                              style={
                                cell
                                  ? `background-image:url(${spriteUrl});background-position:-${cell.x}px -${cell.y}px;background-size:${sprite.width}px ${sprite.height}px`
                                  : undefined
                              }
                            >
                              {!cell && <span class="rcard__mark">{mark(v.data.name)}</span>}
                            </span>
                            <span class="rcard__text">
                              <span class="rcard__name">{v.data.name}</span>
                              <span class="rcard__meta">{metaOf(v)}</span>
                            </span>
                            {mods && <span class="rcard__mods">+{mods.length}</span>}
                          </a>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>

  {/* Карточка предпросмотра: описание и обложка подгружаются по нажатию. */}
  <div class="rgraph__pop" data-rgraph-pop hidden></div>
</div>

<style>
  .rgraph {
    --card-w: 156px;
    --card-h: 38px;
    --card-gap: 6px;
    position: relative;
    margin: 0.5rem 0 1rem;
  }

  .rgraph__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }

  .rgraph__kinds,
  .rgraph__tools {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }

  .rgraph__hint {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    color: var(--c-muted);
  }

  .rgraph__hint--tap {
    display: none;
  }

  @media (hover: none) {
    .rgraph__hint--hover {
      display: none;
    }

    .rgraph__hint--tap {
      display: inline;
    }
  }

  .rgraph__frame {
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--c-surface);
    overflow: hidden;
  }

  /*
   * Прокрутка одна на всю карту, а не по полосе на эпоху: линии связи тянутся
   * между эпохами, и если бы полосы ездили каждая сама по себе, линия
   * приезжала бы не туда.
   */
  .rgraph__scroll {
    overflow: auto;
    max-height: var(--rgraph-height, 78vh);
    overscroll-behavior: contain;
  }

  .rgraph__content {
    position: relative;
    min-width: min-content;
    padding: 0.6rem 0.75rem 1rem;
  }

  .rgraph__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    overflow: visible;
  }

  /* ── Полоса эпохи ─────────────────────────────────────────────────────── */

  .rband + .rband {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: var(--rule);
  }

  .rband__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    position: sticky;
    left: 0;
    /* Заголовок эпохи не уезжает при горизонтальной прокрутке: полоса длиннее экрана. */
    width: max-content;
  }

  .rband__head h3 {
    margin: 0;
    font-size: 0.95rem;
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .rband__range,
  .rband__count {
    font-size: 0.8rem;
    color: var(--c-muted);
  }

  .rband__count::before {
    content: '· ';
  }

  .rband__years {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  /* ── Колонка года ─────────────────────────────────────────────────────── */

  .rcol {
    display: grid;
    gap: 0.25rem;
    width: var(--card-w);
    flex: 0 0 auto;
  }

  .rcol__year {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--c-muted);
    border-bottom: var(--rule);
    padding-bottom: 0.15rem;
  }

  .rcol__stack {
    display: grid;
    gap: var(--card-gap);
    align-content: start;
  }

  /* ── Карточка игры ────────────────────────────────────────────────────── */

  .rcard {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: var(--card-h);
    padding: 0 0.3rem 0 0;
    border: var(--rule);
    border-left: 3px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-surface-2);
    color: var(--c-text);
    text-decoration: none;
    overflow: hidden;
    position: relative;
    transition: border-color 0.12s, background 0.12s;
  }

  .rcard:hover,
  .rcard:focus-visible {
    border-color: var(--c-accent);
    background: var(--c-surface);
  }

  /*
   * Цвет кромки — эпоха. Темы эпох переключаются на весь документ, а на карте
   * все пять видны разом, поэтому цвета здесь свои и заданы на месте.
   */
  .rcard[data-era='soviet'] { border-left-color: #4f9a5c; }
  .rcard[data-era='nineties'] { border-left-color: #2f8f8f; }
  .rcard[data-era='noughties'] { border-left-color: #d1560e; }
  .rcard[data-era='tens'] { border-left-color: #3d7de0; }
  .rcard[data-era='twenties'] { border-left-color: #9a5cd6; }

  .rcard__thumb {
    flex: 0 0 auto;
    width: 36px;
    height: calc(var(--card-h) - 8px);
    border-radius: 2px;
    background-color: var(--c-bg);
    background-repeat: no-repeat;
    filter: var(--photo-filter);
    display: grid;
    place-items: center;
    margin-left: 4px;
  }

  .rcard__mark {
    font-size: 0.6rem;
    font-family: var(--font-display);
    color: var(--c-muted);
    letter-spacing: 0.04em;
  }

  .rcard__text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .rcard__name,
  .rcard__meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rcard__name {
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .rcard__meta {
    font-size: 0.64rem;
    color: var(--c-muted);
    line-height: 1.15;
  }

  .rcard__mods {
    position: absolute;
    right: 3px;
    top: 3px;
    font-size: 0.58rem;
    padding: 0 3px;
    border-radius: 6px;
    background: var(--c-border);
    color: var(--c-text);
  }

  /* ── Подсветка связей ─────────────────────────────────────────────────── */

  /* Пока связь показана, всё лишнее гаснет — цепочка видна сразу. */
  .rgraph[data-lit] .rcard {
    opacity: 0.28;
  }

  .rgraph[data-lit] .rcard[data-lit],
  .rgraph[data-lit] .rcard[data-lit-soft] {
    opacity: 1;
  }

  .rcard[data-lit] {
    border-color: var(--c-accent);
    background: var(--c-surface);
  }

  .rcard[data-lit-soft] {
    border-color: var(--c-border);
  }

  .rcard[data-read] .rcard__name::after {
    content: ' ●';
    color: var(--c-read);
    font-size: 0.7em;
  }

  .rgraph[data-hide-read] .rcard[data-read] {
    display: none;
  }

  /* ── Карточка предпросмотра ───────────────────────────────────────────── */

  .rgraph__pop {
    position: absolute;
    z-index: 5;
    width: 270px;
    padding: 0.6rem 0.7rem;
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--c-surface);
    box-shadow: var(--shadow);
    font-size: 0.82rem;
    pointer-events: none;
  }

  .rgraph__pop[hidden] {
    display: none;
  }

  /*
   * Содержимое карточки предпросмотра и линии связи собирает скрипт уже в
   * браузере, поэтому фирменного атрибута Astro на этих элементах нет и
   * обычные правила до них не достают. Отсюда :global.
   */
  .rgraph__pop :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-bottom: 0.4rem;
    filter: var(--photo-filter);
  }

  .rgraph__pop :global(strong) {
    display: block;
    line-height: 1.2;
  }

  .rgraph__pop :global(.rgraph__popmeta) {
    display: block;
    font-size: 0.75rem;
    color: var(--c-muted);
  }

  .rgraph__pop :global(.rgraph__popsum) {
    display: block;
    margin: 0.3rem 0;
    line-height: 1.35;
  }

  .rgraph__pop :global(a) {
    display: inline-block;
    margin-top: 0.3rem;
    color: var(--c-link);
    pointer-events: auto;
  }

  /* ── Линии связи ──────────────────────────────────────────────────────── */

  /*
   * Выбранный вид родства ярко, прочие связи игры — приглушённо: видно и
   * цепочку, о которой спросили, и то, что у игры есть родня по другой линии.
   */
  .rgraph__wires :global(path[data-wire='strong']) {
    stroke: var(--c-accent);
    stroke-width: 1.8;
    opacity: 0.9;
  }

  .rgraph__wires :global(path[data-wire='soft']) {
    stroke: var(--c-muted);
    stroke-width: 1.2;
    opacity: 0.4;
    stroke-dasharray: 3 3;
  }

  .rgraph__hidecount:not(:empty)::before {
    content: ' ';
  }

  /* На весь экран: карта занимает окно целиком, шапка сайта не мешает. */
  .rgraph[data-full] {
    position: fixed;
    inset: 0;
    z-index: 60;
    margin: 0;
    padding: 0.6rem;
    background: var(--c-bg);
  }

  .rgraph[data-full] .rgraph__scroll {
    max-height: calc(100vh - 7rem);
  }

  @media (max-width: 700px) {
    .rgraph {
      --card-w: 142px;
    }
  }
</style>

<script src="../scripts/rgraph.ts"></script>
