---
/**
 * 3D-модель со Sketchfab.
 *
 * Как и ролик, проигрыватель не грузится, пока читатель не нажмёт: до этого
 * на странице лежит превью и кнопка. WebGL-сцена весит мегабайты и нагружает
 * видеокарту, а большинство читателей статью просто листает.
 *
 * Подпись называет автора и лицензию: этого требуют и Sketchfab, и лицензии
 * Creative Commons, под которыми выложена часть моделей.
 */
import { modelUrl, modelEmbedUrl, type ModelItem } from '../lib/model3d';

interface Props {
  model: ModelItem;
}

const { model } = Astro.props;
const href = modelUrl(model);
---

<figure class="model3d">
  <div class="model3d__frame" data-model3d data-src={modelEmbedUrl(model)} data-title={model.title}>
    {
      model.poster ? (
        <img class="model3d__poster" src={model.poster} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      ) : null
    }
    <button class="model3d__open" type="button" data-model3d-open>
      <span class="model3d__cube" aria-hidden="true">3D</span>
      <span class="visually-hidden">Открыть модель: {model.title}</span>
    </button>
    <span class="model3d__badge">Sketchfab</span>
  </div>
  <figcaption>
    <a href={href} rel="noopener external">{model.title}</a>
    <span class="muted">{` · ${model.author}`}{model.license ? ` · ${model.license}` : ''}</span>
  </figcaption>
</figure>

<style>
  .model3d {
    margin: 0;
  }

  .model3d figcaption {
    margin-top: 0.35rem;
    font-size: 0.85rem;
  }

  .model3d figcaption a {
    color: inherit;
  }

  .model3d__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    /* Превью грузится лениво, и до него рамка не должна быть дырой. */
    background: #1c1c20;
  }

  .model3d__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .model3d__open {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Знак «3D» вместо треугольника: по нему видно, что это не ролик. */
  .model3d__cube {
    display: grid;
    place-items: center;
    width: 68px;
    height: 48px;
    border-radius: 12px;
    background: rgba(20, 20, 22, 0.75);
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    transition: background 0.15s;
  }

  .model3d__open:hover .model3d__cube,
  .model3d__open:focus-visible .model3d__cube {
    background: var(--c-accent);
  }

  .model3d__badge {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgba(20, 20, 22, 0.7);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    pointer-events: none;
  }

  .model3d__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  /*
   * Подмена одна на страницу: моделей в статье бывает несколько, а слушателей
   * на каждую вешать незачем.
   */
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement)?.closest?.('[data-model3d-open]');
    if (!button) return;
    const frame = button.closest('[data-model3d]') as HTMLElement | null;
    const src = frame?.dataset.src;
    if (!frame || !src) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = frame.dataset.title ?? '3D-модель';
    // Набор разрешений — из документации Sketchfab по встраиванию.
    iframe.allow = 'autoplay; fullscreen; xr-spatial-tracking';
    iframe.allowFullscreen = true;
    frame.replaceChildren(iframe);
  });
</script>
