---
import { photoSource, isGameArt, gameArtNote } from '../lib/labels';
import { Image, getImage } from 'astro:assets';
import type { GameNode } from '../lib/graph';
import Video from './Video.astro';
import { videos as videoItems } from '../lib/video';

interface Props {
  game: GameNode;
}

const { game: g } = Astro.props;

const photos = g.data.gallery.filter((p) => p.kind === 'image');
const videos = videoItems(g.data.gallery);

// Большая версия для лайтбокса готовится на сборке, чтобы не грузить оригиналы.
const large = await Promise.all(photos.map((p) => getImage({ src: p.src, width: 1600, format: 'webp' })));

/** Подпись под кадром: у скриншота — правообладатель, у фотографии — автор и лицензия. */
const creditText = (p: (typeof photos)[number]) =>
  isGameArt(p.license) ? gameArtNote(p.license, p.author) : `Фото: ${p.author}, ${p.license}`;
---

{
  photos.length > 0 && (
    <section class="gallery" data-pagefind-ignore>
      <h2>Скриншоты</h2>
      <ul class="gallery__grid">
        {photos.map((photo, i) => (
          <li class="gallery__item">
            <a
              class="gallery__link"
              href={large[i]!.src}
              data-lightbox
              data-caption={photo.caption}
              data-credit={creditText(photo)}
              data-license-url={isGameArt(photo.license) ? '' : (photo.licenseUrl ?? '')}
              data-source={photo.sourceUrl ?? ''}
              data-source-text={photoSource(photo).label}
              data-modified={photo.modified ? '1' : '0'}
            >
              <Image
                src={photo.src}
                alt={photo.caption}
                widths={[320, 640]}
                sizes="(max-width: 700px) 45vw, 320px"
                loading="lazy"
              />
            </a>
            <figcaption class="gallery__caption">
              <span>{photo.caption}</span>
              {/* Одной строкой: перенос строки в шаблоне добавляет лишний пробел. */}
              <span class="muted">{creditText(photo)}{', '}{photoSource(photo).href ? <a href={photoSource(photo).href} rel="noopener external">{photoSource(photo).label}</a> : photoSource(photo).label}{photo.modified ? ', изменено' : ''}</span>
            </figcaption>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  videos.length > 0 && (
    <section class="gallery" data-pagefind-ignore>
      <h2>Видео</h2>
      <ul class="gallery__videos">
        {videos.map((video) => (
          <li>
            <Video video={video} />
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  photos.length > 0 && (
    <dialog class="lightbox" data-lightbox-dialog aria-label="Просмотр изображения">
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="Закрыть">✕</button>
      <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Предыдущее">‹</button>
      <img class="lightbox__image" data-lightbox-image alt="" />
      <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Следующее">›</button>
      <p class="lightbox__caption" data-lightbox-caption />
    </dialog>
  )
}

<style>
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .gallery__item {
    display: grid;
    gap: 0.3rem;
  }

  .gallery__link {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: var(--rule);
    background: var(--c-surface-2);
  }

  .gallery__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--photo-filter);
    transition: transform 0.2s;
  }

  .gallery__link:hover :global(img) {
    transform: scale(1.03);
  }

  .gallery__caption {
    display: grid;
    gap: 0.1rem;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .gallery__videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
    gap: 1rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lightbox {
    border: 0;
    padding: 0;
    width: min(96vw, 1400px);
    max-width: 96vw;
    max-height: 94dvh;
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }

  .lightbox__image {
    display: block;
    width: 100%;
    max-height: 82dvh;
    object-fit: contain;
    border-radius: var(--radius-sm);
    background: #000;
  }

  .lightbox__caption {
    margin: 0.6rem 0 0;
    color: #f0f0f0;
    font-size: 0.85rem;
    text-align: center;
  }

  .lightbox__caption :global(a) {
    color: #c7b8ff;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 2;
    border: 0;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
  }

  .lightbox__close {
    top: -0.5rem;
    right: -0.5rem;
    font-size: 1.1rem;
  }

  .lightbox__nav--prev {
    left: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--next {
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  import '../scripts/gallery';
</script>
