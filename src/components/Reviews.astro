---
/**
 * Что писала пресса: издание, оценка и вердикт своими словами.
 *
 * Вердикты пересказаны, а не процитированы: цитировать чужие рецензии
 * целиком мы не вправе, да и незачем — читателю нужна суть и ссылка на
 * саму статью. Оценка печатается в том виде, в каком её ставило издание:
 * «9/10», «82/100», «4 из 5» — приводить их к одной шкале значило бы
 * выдумывать число, которого никто не ставил.
 */
import type { GameNode } from '../lib/graph';
import { magazineScan } from '../lib/magazine';

interface Props {
  game: GameNode;
}

const { game: g } = Astro.props;
/*
 * Рецензия из журнала, чей скан лежит на archive.org, показывает обложку
 * номера и открывает саму статью в читалке archive.org. Остальные —
 * обычные карточки.
 */
const reviews = g.data.reviews.map((r) => ({ ...r, scan: magazineScan(r.url) }));
const metacritic = g.data.specs.metacritic;
---

{
  reviews.length > 0 && (
    <section class="reviews" data-pagefind-ignore>
      <div class="section-title">
        <h2>Что писала пресса</h2>
        {metacritic && <span class="muted">Metacritic: {metacritic} из 100</span>}
      </div>
      <ul class="reviews__list">
        {reviews.map((r) => (
          <li class:list={['reviews__item card', { 'reviews__item--scan': r.scan }]}>
            {r.scan && (
              <a class="reviews__cover" href={r.url} rel="noopener external" title={`${r.outlet}: номер в библиотеке archive.org`}>
                <img
                  src={r.scan.cover}
                  alt={`Обложка номера: ${r.outlet}`}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
              </a>
            )}
            <div class="reviews__body">
              <div class="reviews__head">
                <a class="reviews__outlet" href={r.url} rel="noopener external">
                  {r.outlet}
                </a>
                {r.score && <span class="reviews__score">{r.score}</span>}
              </div>
              <p class="reviews__verdict">{r.verdict}</p>
              {(r.author || r.date) && (
                <p class="reviews__meta muted">{[r.author, r.date].filter(Boolean).join(' · ')}</p>
              )}
              {r.scan && (
                <div class="reviews__scan" data-scan data-src={r.scan.reader} data-title={`${r.outlet}: страница журнала`}>
                  <button class="reviews__scan-open" type="button" data-scan-open>
                    {r.scan.page ? 'Страница журнала' : 'Открыть номер'}
                  </button>
                  <span class="muted">скан в библиотеке archive.org</span>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .reviews {
    margin: 2rem 0 1.5rem;
  }

  .reviews__list {
    display: grid;
    gap: 0.6rem;
    padding: 0;
    margin: 0.7rem 0 0;
    list-style: none;
  }

  .reviews__item {
    padding: 0.7rem 0.9rem 0.8rem;
  }

  .reviews__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .reviews__outlet {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 1rem;
  }

  .reviews__score {
    flex: none;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--c-accent);
    border-radius: 999px;
    color: var(--c-accent);
    font-size: 0.82rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .reviews__verdict {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .reviews__meta {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
  }

  /* Рецензия из журнала: слева обложка номера, справа всё остальное. */
  .reviews__item--scan {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .reviews__cover {
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    overflow: hidden;
    /* Обложка грузится лениво, и до неё рамка не должна быть дырой. */
    background: var(--c-border);
  }

  .reviews__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .reviews__body {
    min-width: 0;
  }

  .reviews__scan {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  .reviews__scan-open {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--c-accent);
    border-radius: 999px;
    background: none;
    color: var(--c-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .reviews__scan-open:hover,
  .reviews__scan-open:focus-visible {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  /* Открытая читалка встаёт на всю ширину карточки, под обложку. */
  .reviews__scan :global(iframe) {
    flex-basis: 100%;
    width: 100%;
    height: min(78vh, 46rem);
    border: 0;
    border-radius: var(--radius-sm);
    background: #1c1c20;
  }

  .reviews__item--scan:has(iframe) {
    grid-template-columns: 1fr;
  }

  .reviews__item--scan:has(iframe) .reviews__cover {
    display: none;
  }
</style>

<script>
  /*
   * Читалка archive.org грузится только по нажатию: это целое приложение с
   * мегабайтами скриптов, а рецензий в статье бывает шесть.
   */
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement)?.closest?.('[data-scan-open]');
    if (!button) return;
    const box = button.closest('[data-scan]') as HTMLElement | null;
    const src = box?.dataset.src;
    if (!box || !src) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = box.dataset.title ?? 'Страница журнала';
    iframe.allowFullscreen = true;
    iframe.loading = 'lazy';
    box.replaceChildren(iframe);
  });
</script>
